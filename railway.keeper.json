{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.keeper",
    "watchPatterns": [
      "/scripts/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/Dockerfile.keeper",
      "/railway.keeper.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run keeper",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
