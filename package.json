{
  "name": "noxswap",
  "version": "0.1.0",
  "private": true,
  "description": "Confidential swap-size shielding for Uniswap-style AMMs, built on iExec Nox for the WTF Hackathon Summer Edition.",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run compile && npm run test",
    "release:check": "npm run check && npm run audit && npm --prefix frontend run check && npm --prefix frontend run audit",
    "preflight:sepolia": "tsx scripts/preflight-sepolia.ts",
    "release:preflight": "npm run preflight:sepolia && npm --prefix frontend run build:release",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "bootstrap:sepolia": "tsx scripts/bootstrap-sepolia-env.ts",
    "keeper": "tsx scripts/keeper.ts",
    "demo:submit": "tsx scripts/demo-submit-order.ts"
  },
  "devDependencies": {
    "@iexec-nox/nox-hardhat-plugin": "0.1.0",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.17",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "hardhat": "3.11.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "viem": "2.55.10"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "undici": "6.27.0"
  }
}
