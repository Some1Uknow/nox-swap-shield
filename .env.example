# Copy this file to .env. Never commit the resulting file.

# HTTPS Ethereum Sepolia RPC endpoint and the deployment-only wallet.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Existing Sepolia protocol/token addresses. AMM_ROUTER_ADDRESS must be the
# deployed Uniswap SwapRouter02; the deploy script creates a local adapter so
# the privacy router can keep its expiry protection. The release preflight
# verifies the exact V3 pool has nonzero liquidity.
TOKEN_IN_ADDRESS=
TOKEN_OUT_ADDRESS=
AMM_ROUTER_ADDRESS=
AMM_POOL_ADDRESS=
POOL_FEE=3000

# The executor is an EOA that is configured to send batch settlements through
# a private relay. It cannot redirect trader funds.
SETTLEMENT_EXECUTOR_ADDRESS=
SETTLEMENT_EXECUTOR_PRIVATE_KEY=
# Must be an HTTPS private-transaction endpoint.
# For Flashbots Protect on Sepolia use https://rpc-sepolia.flashbots.net.
PRIVATE_RELAY_URL=
# signed-private-transaction (authenticated eth_sendPrivateTransaction) or
# flashbots-protect (private-RPC eth_sendRawTransaction; recommended for Sepolia).
PRIVATE_RELAY_MODE=signed-private-transaction
# Separate unfunded EOA used for the signed-private-transaction request-auth header.
# It remains required by preflight even when Flashbots Protect does not send it.
PRIVATE_RELAY_AUTH_PRIVATE_KEY=

# Privacy and gas bounds. The router rejects smaller/larger values.
MIN_BATCH_SIZE=3
MAX_BATCH_SIZE=12

# Server-only keeper configuration. Both preparation and settlement are sent
# through PRIVATE_RELAY_URL; do not route the settlement proof through a normal
# RPC estimate/send endpoint.
BATCH_WINDOW_MS=20000
PRIVATE_TX_TIMEOUT_MS=120000
PRIVATE_TX_TTL_BLOCKS=5
PRIVATE_PREPARE_GAS_LIMIT=1800000
PRIVATE_SETTLEMENT_GAS_LIMIT=3500000
# Private relays such as Flashbots require a strictly positive priority fee.
MIN_PRIVATE_PRIORITY_FEE_WEI=1000000000
# 0 scans every order/batch after a keeper restart (the safe default). Use a
# positive bound only with durable indexing and an explicit recovery process.
KEEPER_RECOVERY_SCAN_LIMIT=0

# Filled in by scripts/deploy.ts. These are public addresses, not secrets.
SHIELDED_TOKEN_IN_ADDRESS=
SHIELDED_TOKEN_OUT_ADDRESS=
SWAP_SHIELD_ROUTER_ADDRESS=
AMM_ADAPTER_ADDRESS=

# Optional local demo helper. Use a separate disposable Sepolia trader EOA.
# Set FUND_BEFORE_SUBMIT=true only when deliberately demonstrating public
# funding; routine deposits should happen separately from a specific order.
TRADER_PRIVATE_KEY=
INPUT_DECIMALS=18
OUTPUT_DECIMALS=6
SELL_AMOUNT=1
MIN_OUT=1900
FUND_BEFORE_SUBMIT=false

# Public browser configuration belongs only in frontend/.env. Copy
# frontend/.env.example after deployment; never put VITE_ variables, RPC URLs,
# relay URLs, or private keys in this server-side .env file.
